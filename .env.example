# Copy to .env and fill in — never commit .env (NFR-SEC-001)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Local Postgres (create DB first): createdb kkr_transport
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kkr_transport
# Prod example (Neon/Supabase SSL string): paste the full URL here on Render
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=15
